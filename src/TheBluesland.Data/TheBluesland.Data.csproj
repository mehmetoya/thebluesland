<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Embedded so both TheBluesland.UnitTests and any future Neon-setup tooling can read the
         role script via Assembly.GetManifestResourceStream instead of a fragile relative path. -->
    <EmbeddedResource Include="Scripts/create-spotify-cache-roles.sql" />
    <EmbeddedResource Include="Scripts/create-analytics-role.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Patched XML dependency for EF design tooling; does not flow to consumers. -->
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
  </ItemGroup>

</Project>
