<article class="playlist-card">
    @if (CacheSnapshot is { IsPlayable: true, CoverImageUrl: { } coverImageUrl })
    {
        <img class="playlist-card-cover" src="@coverImageUrl" alt="" loading="lazy" />
    }
    else
    {
        <div class="playlist-card-cover playlist-card-cover-placeholder" aria-hidden="true"></div>
    }
    <div class="playlist-card-body">
        <h2>@Content.Title</h2>
        <p class="summary">@Content.Summary</p>
        @if (CacheSnapshot is { IsPlayable: true, TrackCount: { } trackCount })
        {
            <p class="track-count">@trackCount tracks</p>
        }
    </div>
</article>

@code {
    /// <summary>Editorial-only fields (US-005 AC1): must render fully even with no cache data.</summary>
    [Parameter, EditorRequired]
    public required PlaylistContent Content { get; set; }

    [Parameter, EditorRequired]
    public required PlaylistCacheSnapshot CacheSnapshot { get; set; }
}
