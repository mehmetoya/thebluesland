@using Microsoft.AspNetCore.WebUtilities
@using MixMode = TheBluesland.Web.Content.PlaylistMixMode
@inject NavigationManager NavigationManager

<article class="playlist-detail">
    @{
        var activePlaylist = ActivePlaylist;
        var activeCacheSnapshot = ActiveCacheSnapshot;
        var tags = PlaylistTags.All(activePlaylist);
    }

    @* spec 14 "visible breadcrumb navigation on detail pages"; mirrors StructuredData's
       BreadcrumbList JSON-LD built alongside this page in PlaylistDetailPage.razor. *@
    <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">@activePlaylist.Title</span>
    </nav>
    <h1>@activePlaylist.Title</h1>
    <p class="summary">@activePlaylist.Summary</p>

    @* US-010 AC1: mood/genre/occasion/era shown together as one tag list (PlaylistTags.All - era
       included, blank era excluded so a playlist with no era doesn't render an empty tag pill). *@
    @if (tags.Count > 0)
    {
        <ul class="tags">
            @foreach (var tag in tags)
            {
                <li>@tag</li>
            }
        </ul>
    }

    @* US-010 AC1/spec 9.3/SEC-003: rendered through Markdig with DisableHtml() so raw HTML in the
       source Markdown is escaped rather than passed through - see CuratorNoteRenderer's doc
       comment. MarkupString is safe here specifically because the HTML came out of that sanitizing
       pipeline, not from unprocessed user input. *@
    <div class="curator-note">@((MarkupString)CuratorNoteRenderer.ToSanitizedHtml(activePlaylist.CuratorNote))</div>

    @* US-012 AC2/spec 12.4(a)/SEC-004: CanPlay additionally requires a validated spotifyPlaylistId
       (SpotifyPlaylistIdFormat.IsValid) so a malformed id - even one that happens to match an
       existing/available cache row - can never reach the embed src below. *@
    @if (CanPlay(activeCacheSnapshot, activePlaylist))
    {
        @if (activeCacheSnapshot.TrackCount is { } trackCount)
        {
            <p class="track-count">@trackCount tracks</p>
        }
        @if (activeCacheSnapshot.CoverImageUrl is { } coverImageUrl)
        {
            <img class="cover-image" src="@coverImageUrl" alt="@($"{activePlaylist.Title} cover art")" />
        }
    }
    else
    {
        <!-- US-005 AC2/FR-024: never a bare/broken iframe, always a readable fallback message. -->
        <p class="player-unavailable" role="status">
            Cover art and track count are temporarily unavailable.
        </p>
    }

    @* US-010 AC3/FR-022: always present (even when the cache is unavailable, per FR-024) since it
       is built only from the editorial spotifyPlaylistId, never from cache data. US-012 AC2 adds
       HasValidSpotifyPlaylistId: an unvalidated id must not become a Spotify URL at all, so this
       link is simply omitted rather than pointing somewhere unvalidated.
       docs/specs/visitor-and-playlist-click-analytics.md, Design section 5: routes through
       /out/{slug} (WebHostFactory) rather than linking straight to open.spotify.com, so the click
       is recorded as a spotify_click event before the redirect. *@
    @if (HasValidSpotifyPlaylistId(activePlaylist))
    {
        <a href="@OpenInSpotifyUrl(activePlaylist)" class="open-in-spotify" target="_blank" rel="noopener noreferrer">
            Open in Spotify
        </a>
    }

    @if (!string.IsNullOrEmpty(ShareUrl))
    {
        <SharePlaylist Title="@activePlaylist.Title" Url="@ShareUrl" />
    }

    @if (RelatedPlaylists.Count > 0)
    {
        <section class="playlist-mix" aria-labelledby="playlist-mix-heading">
            <div class="playlist-mix-header">
                <h2 id="playlist-mix-heading">Refresh mix</h2>
                <p>Keep the same mood, but try a fresher route through nearby playlists.</p>
            </div>

            @if (AppliedMix is not null)
            {
                <p class="mix-active-status" role="status">Currently exploring: <strong>@AppliedMix.Title</strong></p>
            }

            @if (_showMixPreview)
            {
                <nav class="mix-mode-buttons" aria-label="Choose a mix mode">
                    @foreach (var mode in Enum.GetValues<MixMode>())
                    {
                        var isActive = _selectedMixMode == mode;
                        <a
                            href="@BuildMixQueryString(mode)"
                            class="mix-mode-button @(isActive ? "active" : string.Empty)"
                            aria-current="@(isActive ? "true" : null)">
                            @GetModeLabel(mode)
                        </a>
                    }
                </nav>

                <p class="mix-mode-helper" id="playlist-mix-helper">@GetModeHelperText(_selectedMixMode)</p>

                @if (CurrentMixPreview.Count == 0)
                {
                    <p class="mix-empty" role="status">No nearby mix was found for this mode yet. Keep the current selection and try a different mood.</p>
                }
                else
                {
                    <div class="mix-preview">
                        @foreach (var preview in CurrentMixPreview)
                        {
                            <a href="@($"/playlists/{preview.Slug}")" class="playlist-card-link">
                                <PlaylistCard Content="preview" CacheSnapshot="GetRelatedCacheSnapshot(preview)" />
                            </a>
                        }
                    </div>

                    <div class="mix-preview-actions" aria-live="polite">
                        <a href="@BuildSelectionQueryString(_selectedMixMode, CurrentMixPreview[0].Slug)" class="mix-open-link" aria-label="Use the selected mix for @CurrentMixPreview[0].Title">Use this mix</a>
                        <a href="@BuildDismissedPreviewQueryString()" class="mix-keep-current">Keep current list</a>
                    </div>
                }
            }
            else
            {
                <div class="mix-preview-actions">
                    <a href="@BuildVisiblePreviewQueryString()" class="mix-open-link">Preview again</a>
                    <a href="@BuildResetQueryString()" class="mix-keep-current">Back to current playlist</a>
                </div>
            }
        </section>

        <section class="related-playlists">
            <h2>@(AppliedMix is null ? "Related playlists" : "Fresh mix selection")</h2>
            @foreach (var related in VisibleRelatedPlaylists)
            {
                <a href="@($"/playlists/{related.Slug}")" class="playlist-card-link">
                    <PlaylistCard Content="related" CacheSnapshot="GetRelatedCacheSnapshot(related)" />
                </a>
            }
        </section>
    }
</article>

@code {
    [Parameter]
    public string? ShareUrl { get; set; }

    [Parameter]
    public string? MixQuery { get; set; }

    [Parameter]
    public string? MixAppliedModeQuery { get; set; }

    [Parameter]
    public string? MixSelectionQuery { get; set; }

    [Parameter]
    public string? MixHiddenQuery { get; set; }

    [Parameter]
    public string? MixPreviewQuery { get; set; }

    /// <summary>Editorial-only fields (US-005 AC1/AC3): must render fully with no cache data.</summary>
    [Parameter, EditorRequired]
    public required PlaylistContent Content { get; set; }

    [Parameter, EditorRequired]
    public required PlaylistCacheSnapshot CacheSnapshot { get; set; }

    /// <summary>US-010 AC4: at most three related playlists, already ranked/capped by <see cref="RelatedPlaylistRanking"/>.</summary>
    [Parameter]
    public IReadOnlyList<PlaylistContent> RelatedPlaylists { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<string, PlaylistCacheSnapshot> RelatedCacheSnapshots { get; set; } =
        new Dictionary<string, PlaylistCacheSnapshot>();

    private MixMode _selectedMixMode = MixMode.SameVibe;
    private MixMode _appliedMixMode = MixMode.SameVibe;
    private bool _showMixPreview = true;
    private PlaylistContent? _appliedMix;

    protected override void OnParametersSet()
    {
        _selectedMixMode = ParseMixMode(MixQuery);
        _appliedMixMode = ParseMixMode(MixAppliedModeQuery ?? MixQuery);
        _appliedMix = RelatedPlaylists.FirstOrDefault(playlist =>
            string.Equals(playlist.Slug, MixSelectionQuery, StringComparison.Ordinal));
        _showMixPreview = !string.Equals(MixHiddenQuery, "1", StringComparison.Ordinal)
            && (_appliedMix is null || string.Equals(MixPreviewQuery, "1", StringComparison.Ordinal));
    }

    private IReadOnlyList<PlaylistContent> CurrentMixPreview => BuildMixPreview(_selectedMixMode);
    private IReadOnlyList<PlaylistContent> VisibleRelatedPlaylists => AppliedMix is null
        ? RelatedPlaylists
        : PlaylistMixRanking.Apply(
                RelatedPlaylists,
                Content,
                _showMixPreview ? _selectedMixMode : _appliedMixMode)
            .Take(3)
            .ToList();
    private PlaylistContent ActivePlaylist => AppliedMix ?? Content;
    private PlaylistCacheSnapshot ActiveCacheSnapshot => AppliedMix is null ? CacheSnapshot : GetPlaylistCacheSnapshot(AppliedMix);
    private PlaylistContent? AppliedMix => _appliedMix;

    private bool HasValidSpotifyPlaylistId(PlaylistContent playlist) => SpotifyPlaylistIdFormat.IsValid(playlist.SpotifyPlaylistId);

    private bool CanPlay(PlaylistCacheSnapshot snapshot, PlaylistContent playlist) => snapshot.IsPlayable && HasValidSpotifyPlaylistId(playlist);

    private string OpenInSpotifyUrl(PlaylistContent playlist) => $"/out/{playlist.Slug}";

    private string BuildAbsoluteUrl(string slug) => $"/playlists/{slug}";

    public static MixMode ParseMixMode(string? value)
    {
        var token = value?.Trim();
        if (string.IsNullOrWhiteSpace(token))
        {
            return MixMode.SameVibe;
        }

        return token.ToLowerInvariant() switch
        {
            "same-vibe" => MixMode.SameVibe,
            "more-energetic" => MixMode.MoreEnergetic,
            "relaxed-flow" => MixMode.RelaxedFlow,
            "deeper-cuts" => MixMode.DeeperCuts,
            _ => MixMode.SameVibe,
        };
    }

    public static string ToQueryToken(MixMode mode) => mode switch
    {
        MixMode.SameVibe => "same-vibe",
        MixMode.MoreEnergetic => "more-energetic",
        MixMode.RelaxedFlow => "relaxed-flow",
        MixMode.DeeperCuts => "deeper-cuts",
        _ => throw new ArgumentOutOfRangeException(nameof(mode), mode, null),
    };

    public static string BuildRouteWithMix(string absolutePath, string? existingQueryString, MixMode mode)
    {
        var (basePath, fragment) = SplitPathAndFragment(absolutePath);
        var existingQuery = QueryHelpers.ParseQuery(existingQueryString ?? string.Empty);
        var selectedPlaylistSlug = existingQuery
            .FirstOrDefault(pair => string.Equals(pair.Key, "mix-selection", StringComparison.OrdinalIgnoreCase))
            .Value.ToString();
        var hasSelection = !string.IsNullOrEmpty(selectedPlaylistSlug);
        var query = BuildQueryWithoutMixState(
            existingQueryString,
            preserveSelection: hasSelection,
            preserveAppliedMixMode: hasSelection);
        PreserveAppliedMixMode(query);
        query["mix"] = ToQueryToken(mode);
        if (!string.IsNullOrEmpty(selectedPlaylistSlug))
        {
            query["mix-preview"] = "1";
        }

        return QueryHelpers.AddQueryString(basePath, query) + fragment;
    }

    public static string BuildRouteWithSelection(
        string absolutePath,
        string? existingQueryString,
        MixMode mode,
        string selectedPlaylistSlug)
    {
        var (basePath, fragment) = SplitPathAndFragment(absolutePath);
        var query = BuildQueryWithoutMixState(existingQueryString);
        query["mix"] = ToQueryToken(mode);
        query["mix-selection"] = selectedPlaylistSlug;
        query["mix-applied-mode"] = ToQueryToken(mode);
        return QueryHelpers.AddQueryString(basePath, query) + fragment;
    }

    public static string BuildRouteWithDismissedPreview(string absolutePath, string? existingQueryString)
    {
        var (basePath, fragment) = SplitPathAndFragment(absolutePath);
        var query = BuildQueryWithoutMixState(
            existingQueryString,
            preserveMixMode: true,
            preserveSelection: true,
            preserveAppliedMixMode: true);
        PreserveAppliedMixMode(query);
        query["mix"] = query.GetValueOrDefault("mix") ?? ToQueryToken(MixMode.SameVibe);
        query["mix-hidden"] = "1";
        return QueryHelpers.AddQueryString(basePath, query) + fragment;
    }

    public static string BuildRouteWithVisiblePreview(string absolutePath, string? existingQueryString)
    {
        var (basePath, fragment) = SplitPathAndFragment(absolutePath);
        var query = BuildQueryWithoutMixState(
            existingQueryString,
            preserveMixMode: true,
            preserveSelection: true,
            preserveAppliedMixMode: true);
        PreserveAppliedMixMode(query);
        query["mix"] = query.GetValueOrDefault("mix") ?? ToQueryToken(MixMode.SameVibe);
        query["mix-preview"] = "1";
        return QueryHelpers.AddQueryString(basePath, query) + fragment;
    }

    public static string BuildRouteWithoutMix(string absolutePath, string? existingQueryString)
    {
        var (basePath, fragment) = SplitPathAndFragment(absolutePath);
        var query = BuildQueryWithoutMixState(existingQueryString);
        return QueryHelpers.AddQueryString(basePath, query) + fragment;
    }

    private static Dictionary<string, string?> BuildQueryWithoutMixState(
        string? existingQueryString,
        bool preserveMixMode = false,
        bool preserveSelection = false,
        bool preserveAppliedMixMode = false) =>
        QueryHelpers.ParseQuery(existingQueryString ?? string.Empty)
            .Where(pair =>
                (preserveMixMode && string.Equals(pair.Key, "mix", StringComparison.OrdinalIgnoreCase))
                || (preserveSelection && string.Equals(pair.Key, "mix-selection", StringComparison.OrdinalIgnoreCase))
                || (preserveAppliedMixMode && string.Equals(pair.Key, "mix-applied-mode", StringComparison.OrdinalIgnoreCase))
                || !IsMixStateParameter(pair.Key))
            .ToDictionary(pair => pair.Key, pair => (string?)pair.Value.ToString());

    private static bool IsMixStateParameter(string key) =>
        string.Equals(key, "mix", StringComparison.OrdinalIgnoreCase)
        || string.Equals(key, "mix-selection", StringComparison.OrdinalIgnoreCase)
        || string.Equals(key, "mix-applied-mode", StringComparison.OrdinalIgnoreCase)
        || string.Equals(key, "mix-hidden", StringComparison.OrdinalIgnoreCase)
        || string.Equals(key, "mix-preview", StringComparison.OrdinalIgnoreCase);

    private static void PreserveAppliedMixMode(Dictionary<string, string?> query)
    {
        if (!query.ContainsKey("mix-selection"))
        {
            query.Remove("mix-applied-mode");
            return;
        }

        var modeToken = query.GetValueOrDefault("mix-applied-mode") ?? query.GetValueOrDefault("mix");
        query["mix-applied-mode"] = ToQueryToken(ParseMixMode(modeToken));
    }

    private static (string BasePath, string Fragment) SplitPathAndFragment(string absolutePath)
    {
        var hashIndex = absolutePath.IndexOf('#');
        if (hashIndex < 0)
        {
            return (absolutePath, string.Empty);
        }

        return (absolutePath[..hashIndex], absolutePath[hashIndex..]);
    }

    private string BuildMixQueryString(MixMode mode)
    {
        var currentUri = new Uri(NavigationManager.Uri);
        return BuildRouteWithMix(currentUri.GetLeftPart(UriPartial.Path) + currentUri.Fragment, currentUri.Query, mode);
    }

    private string BuildSelectionQueryString(MixMode mode, string selectedPlaylistSlug)
    {
        var currentUri = new Uri(NavigationManager.Uri);
        return BuildRouteWithSelection(
            currentUri.GetLeftPart(UriPartial.Path) + currentUri.Fragment,
            currentUri.Query,
            mode,
            selectedPlaylistSlug);
    }

    private string BuildDismissedPreviewQueryString()
    {
        var currentUri = new Uri(NavigationManager.Uri);
        return BuildRouteWithDismissedPreview(
            currentUri.GetLeftPart(UriPartial.Path) + currentUri.Fragment,
            currentUri.Query);
    }

    private string BuildVisiblePreviewQueryString()
    {
        var currentUri = new Uri(NavigationManager.Uri);
        return BuildRouteWithVisiblePreview(
            currentUri.GetLeftPart(UriPartial.Path) + currentUri.Fragment,
            currentUri.Query);
    }

    private string BuildResetQueryString()
    {
        var currentUri = new Uri(NavigationManager.Uri);
        return BuildRouteWithoutMix(currentUri.GetLeftPart(UriPartial.Path) + currentUri.Fragment, currentUri.Query);
    }

    private string GetModeLabel(MixMode mode) => mode switch
    {
        MixMode.SameVibe => "Same vibe",
        MixMode.MoreEnergetic => "More energetic",
        MixMode.RelaxedFlow => "Relaxed flow",
        MixMode.DeeperCuts => "Deeper cuts",
        _ => throw new ArgumentOutOfRangeException(nameof(mode), mode, null),
    };

    private string GetModeHelperText(MixMode mode) => mode switch
    {
        MixMode.SameVibe => "Keep the mood and swap in nearby tracks.",
        MixMode.MoreEnergetic => "Push toward brighter, more immediate selections.",
        MixMode.RelaxedFlow => "Lower the intensity while keeping the atmosphere warm.",
        MixMode.DeeperCuts => "Lean toward rarer, more niche discoveries from the same lane.",
        _ => throw new ArgumentOutOfRangeException(nameof(mode), mode, null),
    };

    private IReadOnlyList<PlaylistContent> BuildMixPreview(MixMode mode)
        => PlaylistMixRanking.Apply(RelatedPlaylists, Content, mode)
            .Take(3)
            .ToList();

    private PlaylistCacheSnapshot GetRelatedCacheSnapshot(PlaylistContent related) =>
        RelatedCacheSnapshots.GetValueOrDefault(related.SpotifyPlaylistId, PlaylistCacheSnapshot.Unavailable);

    private PlaylistCacheSnapshot GetPlaylistCacheSnapshot(PlaylistContent playlist)
    {
        if (playlist.Slug == Content.Slug)
        {
            return CacheSnapshot;
        }

        return GetRelatedCacheSnapshot(playlist);
    }
}
