@inject IConfiguration Configuration

@* weekly-archive: ONE plain HTML form with one e-mail input and a submit button per language; each
   button overrides the form's action (formaction) with its own Kit form, so no third-party script
   is needed (CSP only grants form-action to app.kit.com). Kit runs double opt-in, so the address
   is never seen or stored by this site. Hidden until the Kit form ids are configured (or replaced
   by a short note when ShowWhenUnavailable is set). The page language's button is filled, the
   other one outlined. The wording follows the page language (the URL prefix). *@
@if (_forms.Count > 0)
{
    <section class="weekly-subscribe" id="weekly-subscribe" aria-labelledby="weekly-subscribe-title" lang="@Site.Code">
        <h2 id="weekly-subscribe-title">@Site.T.SubscribeHeading</h2>
        <p>@Site.T.SubscribeIntro</p>
        <form class="weekly-subscribe-form" method="post" action="@_forms[0].Action">
            <label for="weekly-subscribe-email">@Site.T.SubscribeEmailLabel</label>
            <div class="weekly-subscribe-controls">
                <input id="weekly-subscribe-email" type="email" name="email_address" required autocomplete="email"
                       inputmode="email" placeholder="@Site.T.SubscribeEmailPlaceholder" />
                @foreach (var form in _forms)
                {
                    <button type="submit" formaction="@form.Action"
                            class="@(form.Language == Site.Code ? "weekly-button" : "weekly-button weekly-button-outline")">@form.Label</button>
                }
            </div>
        </form>
        <p class="weekly-subscribe-note">@Site.T.SubscribeNote <a href="@Site.Url("/privacy")">@Site.T.SubscribePrivacyLink</a>.</p>
    </section>
}
else if (ShowWhenUnavailable)
{
    <p class="weekly-subscribe-soon" lang="@Site.Code">@Site.T.SubscribeSoon</p>
}

@code {
    private sealed record Form(string Language, string Label, string Action);

    /// <summary>Show "Sign-ups open soon." instead of nothing while no Kit form id is configured.</summary>
    [Parameter]
    public bool ShowWhenUnavailable { get; set; }

    private List<Form> _forms = [];

    protected override void OnParametersSet()
    {
        // The page language's button comes first.
        _forms = WeeklySignup.Forms(Configuration)
            .Select(form => new Form(
                form.Language,
                form.Language == SiteLanguage.Turkish ? Site.T.SubscribeTurkishButton : Site.T.SubscribeEnglishButton,
                form.Action))
            .OrderBy(form => form.Language == Site.Code ? 0 : 1)
            .ToList();
    }
}
