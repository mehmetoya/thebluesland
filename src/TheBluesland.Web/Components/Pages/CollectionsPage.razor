@page "/tr/collections"
@page "/en/collections"

<PageTitle>@Site.T.CollectionsTitle</PageTitle>
<PageMetadata Title="@Site.T.CollectionsTitle"
              Description="@Site.T.CollectionsDescription"
              CanonicalPath="/collections" ImagePath="/og-image.png" />

<section class="brand-intro page-intro">
    <h1>@Site.T.CollectionsHeading</h1>
    <p>@Site.T.CollectionsIntro</p>
</section>
@foreach (var dimension in DimensionOrder)
{
    var collections = PlaylistCollections.All.Where(collection => collection.Dimension == dimension).ToList();
    if (collections.Count > 0)
    {
        <section class="collection-group" aria-label="@DimensionName(dimension)">
            <h2>@DimensionName(dimension)</h2>
            <div class="collection-links">
                @foreach (var collection in collections)
                {
                    <a class="collection-link" href="@Site.Url($"/collections/{collection.Slug}")">
                        @* Turkish titles/descriptions come from the taxonomy label; only a collection
                           without one stays English and is marked lang="en". *@
                        <h3 lang="@(collection.HasTitleIn(Site.Code) ? null : Site.EnglishContentLang)">@collection.TitleIn(Site.Code)</h3>
                        <p lang="@(collection.HasTitleIn(Site.Code) ? null : Site.EnglishContentLang)">@collection.DescriptionIn(Site.Code)</p>
                    </a>
                }
            </div>
        </section>
    }
}
<p><a href="@Site.Url("/")">@Site.T.BrowseAllPlaylists</a></p>

@code {
    private static readonly Dimension[] DimensionOrder = [Dimension.Genre, Dimension.Occasion, Dimension.Mood, Dimension.Era];

    private string DimensionName(Dimension dimension) => dimension switch
    {
        Dimension.Genre => Site.T.FilterGenre,
        Dimension.Occasion => Site.T.FilterOccasion,
        Dimension.Mood => Site.T.FilterMood,
        _ => Site.T.FilterEra,
    };
}
