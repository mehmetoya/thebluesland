@page "/tr/weekly"
@page "/en/weekly"
@inject WeeklyIssueRepository Issues
@inject IConfiguration Configuration

<PageTitle>@Site.T.WeeklyTitle</PageTitle>
<PageMetadata
    Title="@Site.T.WeeklyTitle"
    Description="@Site.T.WeeklyDescription"
    CanonicalPath="/weekly"
    ImagePath="/og-image.png" />

<article class="weekly-hub">
    <section class="brand-intro">
        <h1>TheBluesland Weekly</h1>
        <p>@Site.T.WeeklyIntro</p>
    </section>

    <WeeklySubscribe ShowWhenUnavailable="true" />

    <section class="weekly-archive" aria-labelledby="weekly-archive-title">
        <h2 id="weekly-archive-title">@Site.T.WeeklyPastIssues</h2>
        @if (_issues.Count == 0)
        {
            <p class="weekly-empty">
                @Site.T.WeeklyFirstIssue@(_hasSignup ? Site.T.WeeklyFirstIssueSubscribe : "")
            </p>
        }
        else
        {
            <ul class="weekly-cards">
                @foreach (var group in _issues.GroupBy(issue => issue.Id))
                {
                    // The card reads in the page language when that issue exists, else in the other one.
                    var lead = group.FirstOrDefault(issue => issue.Language == Site.Code) ?? group.First();
                    <li class="collection-link weekly-card">
                        <p class="weekly-card-eyebrow">
                            <time datetime="@lead.SendDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@Site.FormatDate(lead.SendDate)</time>
                            <span aria-hidden="true">·</span>
                            @Site.T.WeeklyIssueWord @lead.Number
                        </p>
                        <p class="weekly-card-lede" lang="@lead.Language">@lead.Lede</p>
                        <ul class="weekly-card-headlines" lang="@lead.Language">
                            @foreach (var headline in lead.Headlines.Take(3))
                            {
                                <li>@headline</li>
                            }
                        </ul>
                        <p class="weekly-card-actions">
                            @* Each button names its own language ("Türkçe oku" / "Read in English"), whichever page it is on. *@
                            @foreach (var issue in group.OrderBy(issue => issue.Language == Site.Code ? 0 : 1))
                            {
                                <a class="weekly-button weekly-button-outline" href="@issue.Path" lang="@issue.Language" hreflang="@issue.Language">@(issue.Language == "tr" ? "Türkçe oku" : "Read in English")<span class="sr-only"> (@Site.T.WeeklyIssueWord @issue.Number)</span></a>
                            }
                        </p>
                    </li>
                }
            </ul>
        }
    </section>
</article>

@code {
    private IReadOnlyList<WeeklyIssue> _issues = [];
    private bool _hasSignup;

    protected override void OnInitialized()
    {
        _issues = Issues.Published();
        _hasSignup = WeeklySignup.Forms(Configuration).Count > 0;
    }
}
