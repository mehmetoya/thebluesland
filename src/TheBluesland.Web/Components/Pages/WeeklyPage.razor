@page "/weekly"
@inject WeeklyIssueRepository Issues
@inject IConfiguration Configuration

<PageTitle>TheBluesland Weekly - TheBluesland</PageTitle>
<PageMetadata
    Title="TheBluesland Weekly - TheBluesland"
    Description="Every Monday, five music stories in five minutes, in Turkish and English. Read past issues of TheBluesland Weekly."
    CanonicalPath="/weekly"
    ImagePath="/og-image.png" />

<article class="weekly-hub">
    <section class="brand-intro">
        <h1>TheBluesland Weekly</h1>
        <p>Every Monday: the week's five music stories and why they matter, in Turkish and English.</p>
    </section>

    <WeeklySubscribe Language="en" ShowWhenUnavailable="true" />

    <section class="weekly-archive" aria-labelledby="weekly-archive-title">
        <h2 id="weekly-archive-title">Past issues</h2>
        <p class="weekly-archive-subtitle" lang="tr">Geçmiş sayılar</p>
        @if (_issues.Count == 0)
        {
            <p class="weekly-empty">
                The first issue arrives Monday 08:00 (TR) / 15:00 (EN), Istanbul time.@(_hasSignup ? " Subscribe above to get it first." : "")
            </p>
        }
        else
        {
            <ul class="weekly-cards">
                @foreach (var group in _issues.GroupBy(issue => issue.Id))
                {
                    var lead = group.FirstOrDefault(issue => issue.Language == "en") ?? group.First();
                    <li class="collection-link weekly-card">
                        <p class="weekly-card-eyebrow">
                            <time datetime="@lead.SendDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">@WeeklyIssue.FormatDate(lead.SendDate, "en")</time>
                            <span aria-hidden="true">·</span>
                            @(lead.Language == "tr" ? "Sayı" : "Issue") @lead.Number
                        </p>
                        <p class="weekly-card-lede" lang="@lead.Language">@lead.Lede</p>
                        <ul class="weekly-card-headlines" lang="@lead.Language">
                            @foreach (var headline in lead.Headlines.Take(3))
                            {
                                <li>@headline</li>
                            }
                        </ul>
                        <p class="weekly-card-actions">
                            @foreach (var issue in group)
                            {
                                <a class="weekly-button weekly-button-outline" href="@issue.Path" lang="@issue.Language" hreflang="@issue.Language">@(issue.Language == "tr" ? "Türkçe oku" : "Read in English")<span class="sr-only"> (@(issue.Language == "tr" ? "Sayı" : "Issue") @issue.Number)</span></a>
                            }
                        </p>
                    </li>
                }
            </ul>
        }
    </section>
</article>

@code {
    private IReadOnlyList<WeeklyIssue> _issues = [];
    private bool _hasSignup;

    protected override void OnInitialized()
    {
        _issues = Issues.Published();
        _hasSignup = WeeklySignup.Forms(Configuration).Count > 0;
    }
}
