@page "/tr/about"
@page "/en/about"

<PageTitle>@Site.T.AboutTitle</PageTitle>
<PageMetadata
    Title="@Site.T.AboutTitle"
    Description="@Site.T.AboutDescription"
    CanonicalPath="/about"
    ImagePath="/og-image.png"
    StructuredDataJson="@(new[] { AboutPageJsonLd, FaqPageJsonLd })" />

<article class="about">
    <h1>@Site.T.AboutHeading</h1>
    @if (Site.IsTurkish)
    {
        <p class="lede">
            Ben Mehmet; TheBluesland de Spotify çalma listelerimi paylaştığım bir yer.
            Koleksiyonun merkezinde blues ve rock var; yanlarında folk, caz, soul,
            elektronik müzik ve bunlar arasındaki bağlantılar yer alıyor.
        </p>
        <p>
            Bazı çalma listeleri tek bir sanatçıya ya da belirli bir sese bağlı kalıyor. Diğerleri
            uzun bir yol, sakin bir akşam ya da ruh hâlindeki bir değişiklik için müzikleri bir araya
            getiriyor. Saygı duruşları, filmlerden ilham alan seçkiler ve türler arasında dolaşan
            karışımlar da var.
        </p>
        <p>
            Her çalma listesinin, play'e basmadan önce müziğe dair fikir veren kısa bir notu var.
            Şimdilik çalma listesi başlıkları, özetleri ve notları İngilizce. Ruh hâline, türe, ortama ya da
            döneme göre göz atabilir, <a href="@Site.Url("/collections")">koleksiyonları</a> keşfedebilir
            ya da doğrudan <a href="@Site.Url("/")">tüm çalma listelerine</a> geçebilirsin. Kulağına
            bir şey takılırsa Spotify'da aç ve dinle.
        </p>
        <p>
            Çalma listelerinin yanında <a href="@Site.Url("/weekly")">TheBluesland Weekly</a> de var:
            her pazartesi haftanın beş müzik haberi, Türkçe ve İngilizce, e-postana geliyor.
        </p>
    }
    else
    {
        <p class="lede">
            I'm Mehmet, and TheBluesland is a place to share my Spotify playlists.
            Blues and rock are at the heart of the collection, alongside folk, jazz, soul,
            electronic music, and the connections between them.
        </p>
        <p>
            Some playlists stay with one artist or a particular sound. Others bring together music
            for a long drive, a quiet evening, or a change of mood. There are tributes, film-inspired
            selections, and mixes that wander across genres.
        </p>
        <p>
            Each playlist has a short note to give you a feel for the music before you press play.
            Browse by mood, genre, occasion, or era, explore the <a href="@Site.Url("/collections")">collections</a>,
            or head straight to <a href="@Site.Url("/")">all playlists</a>. When something catches your ear,
            open it in Spotify and listen.
        </p>
        <p>
            Besides the playlists there is <a href="@Site.Url("/weekly")">TheBluesland Weekly</a>:
            every Monday, the week's five music stories, in Turkish and English, in your inbox.
        </p>
    }

    @* Visible markup and FaqPageJsonLd below share this same array by construction (SiteText.AboutFaq),
       so the two can never drift apart - a requirement of Google's FAQPage guidance, not just tidiness. *@
    <h2>@Site.T.AboutFaqHeading</h2>
    @foreach (var (question, answer) in Site.T.AboutFaq)
    {
        <h3>@question</h3>
        <p>@answer</p>
    }
</article>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string AboutPageJsonLd =>
        StructuredDataBuilder.BuildAboutPage(
            "Mehmet",
            Site.T.AboutCuratorDescription,
            BuildAbsoluteUrl(Site.Url("/about")),
            Site.Code);

    private string FaqPageJsonLd => StructuredDataBuilder.BuildFaqPage(Site.T.AboutFaq, Site.Code);

    private string BuildAbsoluteUrl(string path) =>
        HttpContext is null ? path : SiteUrl.BuildAbsolute(HttpContext, path);
}
