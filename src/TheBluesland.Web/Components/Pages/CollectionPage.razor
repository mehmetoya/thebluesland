@page "/tr/collections/{Slug}"
@page "/en/collections/{Slug}"
@inject PlaylistContentRepository ContentRepository
@inject PlaylistCacheLookup CacheLookup

@if (_collection is not null)
{
    <PageTitle>@(_collection.Title + " - TheBluesland")</PageTitle>
    <PageMetadata Title="@(_collection.Title + " - TheBluesland")"
                  Description="@_collection.Description"
                  CanonicalPath="@($"/collections/{_collection.Slug}")" ImagePath="/og-image.png"
                  StructuredDataJson="@(new[] { CollectionPageJsonLd })" />
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="@Site.Url("/")">@Site.T.Home</a> / <a href="@Site.Url("/collections")">@Site.T.NavCollections</a> / <span aria-current="page" lang="@Site.EnglishContentLang">@_collection.Title</span>
    </nav>
    <section class="brand-intro">
        @* Collection copy is English-only (docs/specs/site-i18n.md): marked lang="en" on a Turkish page. *@
        <h1 lang="@Site.EnglishContentLang">@_collection.Title</h1>
        <p lang="@Site.EnglishContentLang">@_collection.Introduction</p>
    </section>
    <section class="catalogue" aria-label="@Site.T.PlaylistsInCollectionLabel">
        @foreach (var playlist in _playlists)
        {
            <a class="playlist-card-link" href="@Site.Url($"/playlists/{playlist.Slug}")">
                <PlaylistCard Content="playlist" CacheSnapshot="@_snapshots.GetValueOrDefault(playlist.SpotifyPlaylistId, PlaylistCacheSnapshot.Unavailable)" />
            </a>
        }
    </section>
    <p><a href="@Site.Url("/collections")">@Site.T.ExploreOtherCollections</a> · <a href="@Site.Url("/")">@Site.T.BrowseAllPlaylists</a></p>
}
else
{
    <ResponseStatusCode Code="StatusCodes.Status404NotFound" />
    <PageTitle>@Site.T.CollectionNotFoundTitle - TheBluesland</PageTitle>
    <h1>@Site.T.CollectionNotFoundTitle</h1>
    <p>@Site.T.CollectionNotFoundBodyBefore<a href="@Site.Url("/collections")">@Site.T.CollectionNotFoundLink</a>@Site.T.CollectionNotFoundBodyAfter</p>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private PlaylistCollection? _collection;
    private IReadOnlyList<PlaylistContent> _playlists = [];
    private IReadOnlyDictionary<string, PlaylistCacheSnapshot> _snapshots = new Dictionary<string, PlaylistCacheSnapshot>();

    protected override async Task OnInitializedAsync()
    {
        _collection = PlaylistCollections.Find(Slug);
        if (_collection is null)
        {
            return;
        }

        var cancellationToken = HttpContext?.RequestAborted ?? CancellationToken.None;
        var published = await ContentRepository.FindAllPublishedAsync(cancellationToken);
        _playlists = PlaylistFilter.Apply(published, _collection.Criteria);
        _snapshots = await CacheLookup.GetSnapshotsAsync(
            _playlists.Select(playlist => playlist.SpotifyPlaylistId).ToList(), cancellationToken);
    }

    private string CollectionPageJsonLd =>
        StructuredDataBuilder.BuildCollectionPageForPlaylists(
            _collection!,
            _playlists,
            BuildAbsoluteUrl(Site.Url($"/collections/{_collection!.Slug}")),
            BuildAbsoluteUrl(Site.Url("/")).TrimEnd('/'),
            SiteLanguage.English); // collection copy is English-only today

    private string BuildAbsoluteUrl(string path) =>
        HttpContext is null ? path : SiteUrl.BuildAbsolute(HttpContext, path);
}
