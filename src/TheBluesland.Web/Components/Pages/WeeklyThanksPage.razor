@page "/tr/weekly/thanks"
@page "/en/weekly/thanks"

@* UX-3: where Kit sends a new subscriber after sign-up. Kit's forms still point at the old
   /weekly/thanks?lang=tr|en; WebHostFactory redirects those here. Static, not indexed, and it
   builds its own <HeadContent> instead of PageMetadata (one HeadContent per page). *@
<PageTitle>@Site.T.WeeklyThanksTitle - TheBluesland</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<article class="weekly weekly-thanks" lang="@Site.Code">
    <h1>@Site.T.WeeklyThanksTitle</h1>
    <p>@Site.T.WeeklyThanksBody</p>
    <p><a href="@Site.Url("/weekly")">@Site.T.WeeklyBackToWeekly</a></p>
</article>
