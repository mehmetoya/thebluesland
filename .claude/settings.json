{
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true
  },
  "permissions": {
    "deny": [
      "Read(//**/.env.hosted)",
      "Read(//**/.env.staging)",
      "Edit(//**/.env.hosted)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.git/check-full-receipts/**)",
      "Bash(git push *--no-verify*)",
      "Bash(supabase link *)",
      "Bash(supabase login *)",
      "Bash(supabase config push *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets *)",
      "Bash(supabase db push *)",
      "Bash(supabase *--linked*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *--visibility*)"
    ],
    "ask": [
      "Bash(supabase db reset *)",
      "Bash(supabase stop *)",
      "Bash(xcrun simctl shutdown *)",
      "Bash(xcrun simctl erase *)",
      "Bash(xcrun simctl delete *)",
      "Bash(pkill *CoreSimulator*)",
      "Bash(killall *CoreSimulator*)",
      "Bash(npm add *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm audit fix *)",
      "Bash(npx expo install *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(docker stop supabase_*)",
      "Bash(eas *)",
      "Bash(npx eas-cli *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh variable set *)",
      "Bash(gh secret *)",
      "Edit(.gitleaksignore)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/.claude/settings.local.json)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git cat-file *)",
      "Bash(git ls-remote *)",
      "Bash(git for-each-ref *)",
      "Bash(git worktree list *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git fetch -q)",
      "Bash(git fetch origin)",
      "Bash(git fetch -q origin)",
      "Bash(pgrep *)",
      "Bash(lsof *)",
      "Bash(xcrun simctl list *)",
      "Bash(docker ps *)",
      "Bash(docker context show)",
      "Bash(npm run check:fast)",
      "Bash(npm run check:task)",
      "Bash(npm run check:deps)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(curl -s -m 5 -o /dev/null -w \"%{http_code}\\n\" http://127.0.0.1:54321/rest/v1/)",
      "Bash(osascript -e 'tell application \"DeviceHub\" to quit')"
    ]
  }
}
